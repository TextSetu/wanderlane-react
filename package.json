{
    "name": "wanderlane-react",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Wanderlane traveller app — a reference integration of TextSetu content delivery (OTA) in a Vite + React SPA, where a newly published language needs no rebuild.",
    "license": "MIT",
    "packageManager": "pnpm@10.30.0",
    "engines": {
        "node": ">=20.9"
    },
    "scripts": {
        "dev": "vite --port 3030",
        "build": "tsc -b && vite build",
        "preview": "vite preview --port 3030",
        "typecheck": "tsc -b",
        "check": "tsc -b"
    },
    "dependencies": {
        "i18next": "^26.3.4",
        "react": "19.1.1",
        "react-dom": "19.1.1",
        "react-i18next": "^17.0.8",
        "react-router-dom": "^7.9.5"
    },
    "devDependencies": {
        "@types/react": "19.1.9",
        "@types/react-dom": "19.1.7",
        "@vitejs/plugin-react": "^5.1.1",
        "tailwindcss": "4.1.14",
        "@tailwindcss/vite": "4.1.14",
        "typescript": "5.9.3",
        "vite": "^7.2.4",
        "@types/node": "24.7.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@tailwindcss/oxide",
            "esbuild"
        ]
    }
}
